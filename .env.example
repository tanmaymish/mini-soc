# ── Storage backend ────────────────────────────────────────────────
# If DATABASE_URL is set, the PostgreSQL backend is used (works great with
# serverless Postgres like Neon or Supabase). Leave it blank to use MongoDB
# (the docker-compose default). NEVER commit a real connection string.
#
# Example (Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# MongoDB (used only when DATABASE_URL is blank)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mini_soc

# ── Flask ──────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# ── Detection Thresholds ───────────────────────────────────────────
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
PORT_SCAN_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=30

# ── Alerting ───────────────────────────────────────────────────────
# Set this to a Slack/Discord webhook URL to receive external notifications
WEBHOOK_URL=
# Only alerts with this severity or higher trigger webhooks (low, medium, high, critical)
ALERT_MIN_SEVERITY=high
